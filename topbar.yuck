(defwidget topbar-left []
  (box :space-evenly false
    (workspaces)
    (kanata)))

(defwidget topbar-center []
  (box
    (datetime)))

(defwidget topbar-right []
  (box :space-evenly false
       :halign "end"
       :class "topbar-right"
    (notification-bell :icon bell)
    (volume)
    (packs)
    (sys)
    (pow)))

(defwidget topbar []
  (centerbox :class "topbar"
             :orientation "h"
             (topbar-left)
             (topbar-center)
             (topbar-right)))

