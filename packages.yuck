(defpoll check-packages :interval "30m"
  `checkupdates | wc -l`)

(defwidget packs []
  (button :onclick `${EWW_CONFIG_DIR}/scripts/eww-check-packs.sh`
          :timeout "24h"
          :class "packs-btn"
   (box :orientation "h"
        :space-evenly false
    (label :class "packs" :text "")
  "${check-packages}")))


