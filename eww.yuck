(defwindow bar
           :monitor 0
           :geometry (geometry :x "0%"
                               :y "0%"
                               :width "100%"
                               :height "25px"
                               :anchor "top center")
           :stacking "fg"
           :exclusive true
           :windowtype "dock"
           :wm-ignore false
  (topbar))

(defwindow calwin
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "350px"
                      :anchor "top center")
  :stacking "fg"
  :exclusive false
  :focusable false
(bigcal))


(defvar time-visible false)
(defvar dd `date %d`)
(defvar mm `date %m`)
(defvar yy `date %Y`)
(defvar cal-open false)
(defvar pow-hov false)
(defvar hw-hov false)
(defvar vol-hov false)
(defvar checking-vol true)
(defvar vol-level 0)

(defpoll vol-state :interval "1s" :run-while checking-vol
  `./scripts/check-vol.sh`)

(defpoll time :interval "1s"
              :initial ""
              :run-while time-visible
`date "+%a, %b %d %-I:%M"`)

(defpoll check-packages :interval "30m"
  `checkupdates | wc -l`)

(deflisten focused-ws :initial "0"
  `mmsg watch tags DP-3 | jq --unbuffered '.tags[] | select(.is_active == true) | .index'`)

(deflisten layer :initial "null"
  `$HOME/.cargo/bin/klm`)

(defwidget workspaces []
  (box :space-evenly false
    (for t in "[1,2,3,4,5,6,7,8,9]"
      (button :class "${focused-ws == t ? 'focused' : 'ws'}" :onclick "mmsg dispatch view,${t},1,0" t))))

(defwidget kanata []
  (label :text layer))

(defwidget datetime []
  (button :class "datetime"
          :onclick 
          {cal-open ? "eww close calwin; eww update cal-open=false" : "eww open calwin; eww update cal-open=true"}
  time))


(defwidget bigcal []
  (box
    (calendar :day dd
              :month mm
              :year yy
              :show-details true
              :show-heading true
              :show-day-names true)))

(defwidget packs []
  (button :onclick `kitty --title "pack updates" /usr/bin/env sh -c 'paru -Syu && echo Done && read'`
          :timeout "24h"
  "  ${check-packages}"))

(defwidget sys []
  (systray :class "systray"
           :halign "end"
           :space-evenly true
           :spacing 10
           :style "padding-left: 10px;"
           :orientation "h"
           :icon-size 18
           :prepend-new false))

(defwidget cpu []
  (label :text "CPU: ${round(EWW_CPU.avg, 0)}%"))

(defwidget ram []
 (label :text "RAM: ${round(EWW_RAM.used_mem_perc, 0)}%"))

(defwidget hw []
  (eventbox :onhover `eww update hw-hov=true`
            :onhoverlost `eww update hw-hov=false`
    (box :space-evenly false
      (revealer :transition "slideleft"
                :reveal hw-hov
                :duration "500ms"
        (box :style "padding-right: 4px;"
             :spacing 4
          (cpu)
          (ram)))
      (label :text "󰍛 "))))

(defwidget pow []
  (eventbox :onhover `eww update pow-hov=true`
            :onhoverlost `eww update pow-hov=false`
    (box :space-evenly false
      (revealer :transition "slideleft"
                :reveal pow-hov
                :duration "500ms"
        (box
          (button :onclick `pidof mango | xargs kill` "󰗼")
          (button :onclick `reboot` "")))
      (button :onclick `shutdown -h now` "󰐥"))))

(defwidget topbar-left []
  (box :space-evenly false
    (workspaces)
    (kanata)))

(defwidget topbar-center []
  (box
    (datetime)))

(defwidget topbar-right []
  (box :space-evenly false
       :spacing 10
       :halign "end"
       :style "padding-right: 10px;"
    (packs)
    (eventbox :onhover `eww update vol-hov=true`
              :onhoverlost `eww update vol-hov=false`
      (box :space-evenly false
        (revealer :transition "slideleft"
                  :reveal vol-hov
                  :duration "500ms"
          (scale :class "volume"
                 :width 150
                 :draw-value true
                 :value-pos "right"
                 :round-digits 0
                 :value vol-level
                 :min 0
                 :max 100
                 :orientation "h"
                 :onchange `amixer sset Master {}%`))
        (button :onclick `amixer set Master toggle; eww poll vol-state`
          {vol-state == "muted" ? "" : ""})))
    (hw)
    (sys)
    (pow)))

(defwidget topbar []
  (centerbox :class "topbar"
             :orientation "h"
             (topbar-left)
             (topbar-center)
             (topbar-right)))
