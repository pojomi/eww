(defwindow bar
           :monitor 0
           :geometry (geometry :x "0%"
                               :y "0%"
                               :width "100%"
                               :height "25px"
                               :anchor "top center")
           :stacking "fg"
           :exclusive true
           :windowtype "dock"
           :wm-ignore false
  (topbar))

(defwindow calwin
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "350px"
                      :anchor "top center")
  :stacking "fg"
  :exclusive false
  :focusable false
(bigcal))

(defwindow dunst
  :monitor 0
  :geometry (geometry :height "300px"
                      :width "250px"
                      :anchor "top right")
  :stacking "fg"
  :exclusive false
  :focusable false
  (scroll :width "250px"
          :vscroll true
          :hscroll false
    (box :orientation "v"
         :space-evenly false
         :spacing 10
      (for n in dunst-notifs
        (box :orientation "v"
            :space-evenly false
          (label :width "250px" :wrap false :markup "<b>${replace(n.app, '<[^>]*>', '')}</b>")
          (label :width "250px" :wrap true :text "${replace(n.body, '<[^>]*>', '')}"))))))

(defvar time-visible false)
(defvar dd `date %d`)
(defvar mm `date %m`)
(defvar yy `date %Y`)
(defvar cal-open false)
(defvar pow-hov false)
(defvar hw-show false)
(defvar vol-hov false)
(defvar vol-level 0)
(defvar show-vol false)
(defvar muted false)
(defvar have-notifications false)
(defvar dunst-notifs "")
(defvar dunst-open false)

(defpoll time :interval "1s"
              :initial ""
              :run-while time-visible
`date "+%a, %b %d %-I:%M"`)

(defpoll check-packages :interval "30m"
  `checkupdates | wc -l`)

(deflisten focused-ws :initial "0"
  `mmsg watch tags DP-3 | jq --unbuffered '.tags[] | select(.is_active == true) | .index'`)

(deflisten layer :initial "null"
  `$HOME/.cargo/bin/klm`)

(defwidget workspaces []
  (box :space-evenly false
    (for t in "[1,2,3,4,5,6,7,8,9]"
      (button :class "${focused-ws == t ? 'focused' : 'ws'}" :onclick "mmsg dispatch view,${t},1,0" t))))

(defwidget kanata []
  (label :text layer))

(defwidget datetime []
  (button :class "datetime"
          :onclick 
          {cal-open ? "eww close calwin; eww update cal-open=false" : "eww open calwin; eww update cal-open=true"}
  time))


(defwidget bigcal []
  (box
    (calendar :day dd
              :month mm
              :year yy
              :show-details true
              :show-heading true
              :show-day-names true)))

(defwidget packs []
  (button :onclick `$HOME/.local/bin/check-packs`
          :timeout "24h"
  "  ${check-packages}"))

(defwidget sys []
  (systray :class "systray"
           :halign "end"
           :space-evenly true
           :spacing 10
           :orientation "h"
           :icon-size 18
           :prepend-new false))

(defwidget hw []
  (box :space-evenly false
    (revealer :transition "slideleft"
              :reveal hw-show
              :duration "500ms"
      (box :style "padding-right: 4px;"
            :spacing 4
        (label :text "CPU: ${round(EWW_CPU.avg, 0)}%")
        (label :text "RAM: ${round(EWW_RAM.used_mem_perc, 0)}%")))
    (button :onclick { hw-show ? `eww u hw-show=false` : `eww u hw-show=true` } "󰍛 ")))

(defwidget pow []
  (eventbox :onhover `eww update pow-hov=true`
            :onhoverlost `eww update pow-hov=false`
            :style "padding: 9px;"
    (box :space-evenly false
      (revealer :transition "slideleft"
                :reveal pow-hov
                :duration "500ms"
        (box
          (button :onclick `pidof mango | xargs kill` "󰗼")
          (button :onclick `systemctl reboot` "")))
      (button :onclick `systemctl poweroff` "󰐥"))))

(defwidget topbar-left []
  (box :space-evenly false
    (workspaces)
    (kanata)))

(defwidget topbar-center []
  (box
    (datetime)))

(defwidget topbar-right []
  (box :space-evenly false
       :spacing "9px"
       :halign "end"
    (packs)
    (hw)
    (sys)
    (button :onclick {dunst-open ? `eww u dunst-open=false; eww close dunst` : `$HOME/.local/bin/dunst-json`}
      {have-notifications ? "" : ""})
    (eventbox :onhover `eww update vol-hov=true`
              :onhoverlost `eww update vol-hov=false`
      (box :space-evenly false
        (revealer :transition "slideleft"
                  :reveal vol-hov
                  :duration "500ms"
          (scale :class "volume"
                 :width 150
                 :draw-value true
                 :value-pos "right"
                 :round-digits 0
                 :value vol-level
                 :min 0
                 :max 100
                 :orientation "h"
                 :onchange `amixer sset Master {}%`))
        (button :onclick "amixer set Master toggle;{show-vol ? `eww u muted=false;` : `eww u muted=true`}"
                         
            ;;; :onrightclick {show-vol ? `eww u show-vol=false; eww c audio` : `eww u show-vol=true; eww o audio`}
          {muted ? "" : ""})))
    (pow)))

(defwidget topbar []
  (centerbox :class "topbar"
             :orientation "h"
             (topbar-left)
             (topbar-center)
             (topbar-right)))
