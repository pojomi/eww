(include "./topbar.yuck")
(include "./notifications.yuck")
(include "./packages.yuck")
(include "./calendar.yuck")
(include "./power.yuck")
(include "./systray.yuck")
(include "./volume.yuck")
(include "./cpu-ram.yuck")
(include "./workspaces.yuck")
(include "./kanata.yuck")

(defwindow bar
           :monitor 0
           :geometry (geometry :x "0%"
                               :y "0%"
                               :width "100%"
                               :height "25px"
                               :anchor "top center")
           :stacking "fg"
           :exclusive true
           :windowtype "dock"
           :wm-ignore false
  (topbar))

